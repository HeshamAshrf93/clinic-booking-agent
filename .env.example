# Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

CLINIC_NAME=Nile Care Clinic
CLINIC_TZ=Africa/Cairo
DB_PATH=clinic.db

# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup)
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=choose-any-long-random-string
WA_APP_SECRET=
GRAPH_API_VERSION=v21.0

MAX_AGENT_STEPS=6
MAX_MESSAGES_PER_HOUR=30

# Enables POST /chat for local testing. Keep false in production.
DEMO_MODE=false
