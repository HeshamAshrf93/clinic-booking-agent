# Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used automatically if the main model is busy (comma-separated)
GEMINI_FALLBACK_MODELS=gemini-flash-latest

# Backup provider, used automatically if Gemini is down. Any OpenAI-compatible API.
# Default is Groq (free key: https://console.groq.com/keys). Leave empty to disable.
BACKUP_API_KEY=
BACKUP_BASE_URL=https://api.groq.com/openai/v1
BACKUP_MODEL=openai/gpt-oss-120b

# Who answers first. "backup,gemini" puts Groq first (fast); Gemini becomes the fallback.
PROVIDER_ORDER=gemini,backup
# Gemini thinking effort: minimal / low / medium / high (lower = faster replies)
GEMINI_THINKING=low

# Voice messages: Whisper speech-to-text. Uses BACKUP_API_KEY unless set.
STT_MODEL=whisper-large-v3-turbo

CLINIC_NAME=Nile Care Clinic
CLINIC_TZ=Africa/Cairo
DB_PATH=clinic.db

# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup)
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=choose-any-long-random-string
WA_APP_SECRET=
GRAPH_API_VERSION=v21.0

MAX_AGENT_STEPS=6
MAX_MESSAGES_PER_HOUR=30

# Enables POST /chat for local testing. Keep false in production.
DEMO_MODE=false
